generator client {
  provider   = "prisma-client-js"
  // output   = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum SportType {
  FOOTBALL
  CRICKET
  BOTH
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  phone                String    @unique
  passwordHash         String
  role                 Role      @default(USER)
  isVerified           Boolean   @default(false)
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  failedLoginAttempts  Int       @default(0)
  lockoutUntil         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  refreshTokens RefreshToken[]
  bookings      Booking[]
  reviews       Review[]
  adminLogs     AuditLog[]     @relation("AdminLogs")
  couponUsages  CouponUsage[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // for faster lookups of refresh tokens by user
  @@index([expiresAt]) // for faster cleanup of expired tokens
  @@map("refresh_tokens")
}

model Turf {
  id           String    @id @default(uuid())
  name         String    @unique
  description  String
  address      String
  city         String
  sportType    SportType
  pricePerHour Decimal   @db.Decimal(10, 2)
  openTime     String
  closeTime    String
  rating       Float     @default(0)
  isActive     Boolean   @default(true)
  images       String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  slots    Slot[]
  bookings Booking[]
  reviews  Review[]

  @@map("turfs")
}

model Slot {
  id        String   @id @default(uuid())
  turfId    String
  date      DateTime @db.Date
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)

  turf    Turf     @relation(fields: [turfId], references: [id])
  booking Booking?

  @@unique([turfId, date, startTime]) // ensures that a turf cannot have two slots at the same time on the same date
  @@index([turfId, date]) // for faster lookups of available slots by turf and date
  @@index([isBooked]) // for faster lookups of available slots
  @@map("slots")
}

model Booking {
  id            String        @id @default(uuid())
  userId        String
  turfId        String
  slotId        String        @unique
  totalAmount   Decimal       @db.Decimal(10, 2) // db.decimal is used for currency
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(INITIATED)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  turf        Turf         @relation(fields: [turfId], references: [id])
  slot        Slot         @relation(fields: [slotId], references: [id])
  payment     Payment?
  review      Review?
  couponUsage CouponUsage?

  @@index([userId, createdAt]) // for faster lookups of a user's bookings
  @@index([turfId, status]) // for faster lookups of bookings by turf and status
  @@index([status]) // for faster lookups of bookings by status
  @@index([createdAt]) // for faster date-range queries in analytics
  @@map("bookings")
}

model Payment {
  id        String        @id @default(uuid())
  bookingId String        @unique
  amount    Decimal       @db.Decimal(10, 2)
  currency  String        @default("usd")
  status    PaymentStatus @default(INITIATED)

  stripePaymentIntentId String  @unique
  stripeClientSecret    String?
  stripeChargeId        String?

  paidAt        DateTime?
  failureReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([status])
  @@index([stripePaymentIntentId])
  @@index([paidAt]) // for faster date-range queries in analytics
  @@map("payments")
}

model WebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())

  @@map("webhook_events")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  turfId    String
  bookingId String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  turf    Turf    @relation(fields: [turfId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([turfId])
  @@index([userId])
  @@map("reviews")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetId   String
  targetType String
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  admin User @relation("AdminLogs", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Coupon {
  id                String        @id @default(uuid())
  code              String        @unique
  description       String?
  discountType      DiscountType
  discountValue     Decimal       @db.Decimal(10, 2)
  minOrderAmount    Decimal       @db.Decimal(10, 2)
  maxDiscountAmount Decimal       @db.Decimal(10, 2)
  usageLimit        Int?
  usedCount         Int           @default(0)
  userUsageLimit    Int           @default(1)
  validFrom         DateTime
  validUntil        DateTime
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  couponUsages      CouponUsage[]

  @@index([code])
  @@index([isActive, validUntil])
  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  bookingId String   @unique
  discount  Decimal  @db.Decimal(10, 2)
  usedAt    DateTime @default(now())

  coupon  Coupon  @relation(fields: [couponId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_usages")
}
