# App Settings
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
COOKIE_SECRET=
SHOW_SWAGGER=true
SLOT_GENERATION_DAYS=30

# Database (PostgreSQL & Prisma)
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=turfbook
DATABASE_URL="postgresql://postgres:password@localhost:5433/turfbook?schema=public"

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Redis Cache & Queue
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_NAME=
REDIS_SENTINEL_PASSWORD=

# Mail Service (SMTP)
MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@turfsync.com

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio (SMS Service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Monitoring & Observability (Grafana & Sentry)
GF_SECURITY_ADMIN_PASSWORD=admin123
SENTRY_DSN=

# Security & Rate Limiting
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=10
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=100

# Admin Seed Data
ADMIN_SEED_EMAIL=admin@turfsync.com
ADMIN_SEED_PASSWORD=AdminPassword123!

# k6 Load Testing (Optional)
BASE_URL=http://localhost:4000
THRESHOLD_MS=500